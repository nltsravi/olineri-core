<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Header -->
        <TextView
            android:id="@+id/tvSdkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E8EAF6"
            android:padding="12dp"
            android:text="Initializing Olineri Offline SDK..."
            android:textColor="#1A237E"
            android:textStyle="bold" />

        <!-- Step 1: Runtime Initialization & Language Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="1. Runtime &amp; Language Selection"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnInitRuntime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Re-Initialize Runtime &amp; Add Trusted Key" />

        <Spinner
            android:id="@+id/spinnerLanguage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- Step 2: Language Package Management -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="2. Offline Language Package Management"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnInstallPackage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Install Pkg" />

            <Button
                android:id="@+id/btnListPackages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="List Pkgs" />

            <Button
                android:id="@+id/btnUninstallPackage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Uninstall" />
        </LinearLayout>

        <!-- Step 3: Session & Target Phrase -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="3. Session &amp; Target Brahmic Phrase"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCreateSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Session for Selected Language" />

        <Spinner
            android:id="@+id/spinnerSampleWord"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/etReferenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Tamil, Sanskrit, Hindi, or Telugu text"
            android:inputType="text"
            android:text="பழம்"
            android:textSize="20sp" />

        <!-- Step 4: Pronunciation Assessment -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="4. Assess Pronunciation (16 kHz Float32 PCM)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAssessTestAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Assess (Test Audio)" />

            <Button
                android:id="@+id/btnRecordMic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Record Mic (1.5s)" />
        </LinearLayout>

        <!-- Step 5: Character-Level Highlighting & Phoneme Feedback -->
        <TextView
            android:id="@+id/tvHighlightedWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FAFAFA"
            android:gravity="center"
            android:padding="16dp"
            android:text="பழம்"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverallScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="6dp"
            android:text="Overall Score: -- / 100"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutPhonemeCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Step 6: Memory Trim -->
        <Button
            android:id="@+id/btnTrimMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="5. Trim Idle Model Memory (runtime.trimMemory)" />

        <!-- Live SDK Call Log Console -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Live SDK Function Call Log"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConsoleLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#263238"
            android:fontFamily="monospace"
            android:minLines="6"
            android:padding="12dp"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

